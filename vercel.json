{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/book-now", "destination": "/Book-now/", "permanent": true },
    { "source": "/book-now/", "destination": "/Book-now/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/gallery/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/gallery_gen/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
